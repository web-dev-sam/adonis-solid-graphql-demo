    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@solidjs/meta": "^0.29.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.5.0",
    "@urql/core": "^6.0.1",
    "@urql/solid": "^1.0.1",
    "eslint": "^10.1.0",
    "hot-hook": "^1.0.0",
    "inertia-adapter-solid": "1.0.0-beta.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "solid-js": "^1.9.7",
    "typescript": "~6.0.2",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.6",
