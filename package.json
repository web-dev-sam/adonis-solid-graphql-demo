  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/lucid": "^22.4.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^5.1.0",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.3.0",
    "better-sqlite3": "^12.8.0",
    "edge.js": "^6.5.0",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.21.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "solid-sonner": "^0.2.5"
  },
  "hotHook": {
    "boundaries": [
